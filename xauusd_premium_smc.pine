//@version=6
indicator("XAUUSD Premium SMC", overlay=true, max_labels_count=200, max_lines_count=200, max_boxes_count=200)

// ========================
// Inputs
// ========================
groupStructure = "Structure"
groupZones = "Zones"
groupFilters = "Filters"
groupRisk = "Risk/Targets"
groupVisual = "Visual"

swingLen = input.int(3, "Swing Length", minval=2, maxval=20, group=groupStructure)
eqToleranceAtr = input.float(0.15, "EQH/EQL Tolerance (ATR %)", minval=0.01, maxval=1.0, step=0.01, group=groupStructure)

showOB = input.bool(true, "Show Order Blocks", group=groupZones)
showFVG = input.bool(true, "Show FVG", group=groupZones)
maxZones = input.int(20, "Max Active Zones", minval=5, maxval=60, group=groupZones)

useSessionFilter = input.bool(true, "Session Filter (LN/NY)", group=groupFilters)
useVolFilter = input.bool(true, "Volume Filter", group=groupFilters)
useAtrFilter = input.bool(true, "Volatility Filter", group=groupFilters)
atrLen = input.int(14, "ATR Length", minval=5, maxval=50, group=groupFilters)
atrMinPct = input.float(0.0008, "Min ATR/Close", minval=0.0001, maxval=0.01, step=0.0001, group=groupFilters)
rvLen = input.int(20, "Relative Volume Length", minval=5, maxval=100, group=groupFilters)
rvMin = input.float(1.1, "Relative Volume Min", minval=0.5, maxval=5.0, step=0.1, group=groupFilters)

slAtrMult = input.float(1.2, "SL ATR Mult", minval=0.5, maxval=5, step=0.1, group=groupRisk)
tp1RR = input.float(1.5, "TP1 RR", minval=0.5, maxval=10, step=0.1, group=groupRisk)
tp2RR = input.float(2.5, "TP2 RR", minval=1.0, maxval=15, step=0.1, group=groupRisk)
tp3RR = input.float(4.0, "TP3 RR", minval=1.0, maxval=20, step=0.1, group=groupRisk)

showDashboard = input.bool(true, "Show Dashboard", group=groupVisual)
showSessions = input.bool(true, "Highlight Sessions", group=groupVisual)

// ========================
// Helpers
// ========================
f_clamp(v, lo, hi) =>
    math.max(lo, math.min(hi, v))

f_boolToTxt(v) =>
    v ? "YES" : "NO"

f_trendTxt(v) =>
    v > 0 ? "BULL" : v < 0 ? "BEAR" : "NEUTRAL"

f_tfTrend(tf) =>
    c = request.security(syminfo.tickerid, tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    e = request.security(syminfo.tickerid, tf, ta.ema(close, 50), barmerge.gaps_off, barmerge.lookahead_off)
    c > e ? 1 : c < e ? -1 : 0

// ========================
// Core metrics
// ========================
atr = ta.atr(atrLen)
atrPct = atr / close
rv = volume / math.max(ta.sma(volume, rvLen), 1)
deltaApprox = (close - open) * volume
deltaBull = deltaApprox > 0
deltaBear = deltaApprox < 0
barClosed = barstate.isconfirmed

// ========================
// Sessions
// ========================
isLondon = not na(time(timeframe.period, "0800-1700:1234567", "Europe/London"))
isNY = not na(time(timeframe.period, "0800-1700:1234567", "America/New_York"))
isAsia = not na(time(timeframe.period, "0000-0900:1234567", "Asia/Singapore"))
isLNOverlap = isLondon and isNY
sessionOK = not useSessionFilter or isLondon or isNY

bgcolor(showSessions and isAsia ? color.new(color.blue, 94) : na)
bgcolor(showSessions and isLondon ? color.new(color.orange, 92) : na)
bgcolor(showSessions and isNY ? color.new(color.green, 93) : na)

// ========================
// Structure engine (non-repaint by pivot confirmation)
// ========================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na

if not na(ph)
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - swingLen
if not na(pl)
    lastSwingLow := pl
    lastSwingLowBar := bar_index - swingLen

var int extTrend = 0
bullBOS = barClosed and not na(lastSwingHigh) and close > lastSwingHigh
bearBOS = barClosed and not na(lastSwingLow) and close < lastSwingLow

if bullBOS
    extTrend := 1
if bearBOS
    extTrend := -1

bullCHoCH = barClosed and extTrend[1] == -1 and bullBOS
bearCHoCH = barClosed and extTrend[1] == 1 and bearBOS
bullMSS = bullCHoCH and close > open and (close - open) > atr * 0.25
bearMSS = bearCHoCH and close < open and (open - close) > atr * 0.25

// Strong / weak swings (simple rule-based approximation)
strongHigh = not na(lastSwingHigh) and close < lastSwingHigh
strongLow = not na(lastSwingLow) and close > lastSwingLow

// ========================
// Equal highs/lows + liquidity sweeps
// ========================
eqTol = atr * eqToleranceAtr
var float prevHighPivot = na
var float prevLowPivot = na
eqHigh = not na(ph) and not na(prevHighPivot) and math.abs(ph - prevHighPivot) <= eqTol
eqLow = not na(pl) and not na(prevLowPivot) and math.abs(pl - prevLowPivot) <= eqTol
if not na(ph)
    prevHighPivot := ph
if not na(pl)
    prevLowPivot := pl

buySideSweep = barClosed and not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh
sellSideSweep = barClosed and not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow

// ========================
// Zone engine: OB + FVG
// ========================
var obTop = array.new_float()
var obBot = array.new_float()
var obDir = array.new_int()     // 1 bull, -1 bear
var obBox = array.new_box()
var obActive = array.new_bool()

var fvgTop = array.new_float()
var fvgBot = array.new_float()
var fvgDir = array.new_int()    // 1 bull, -1 bear
var fvgBox = array.new_box()
var fvgActive = array.new_bool()

f_trimZones(_top, _bot, _dir, _box, _active) =>
    while array.size(_top) > maxZones
        b = array.shift(_box)
        if not na(b)
            box.delete(b)
        array.shift(_top)
        array.shift(_bot)
        array.shift(_dir)
        array.shift(_active)

f_addOB(_dir, _top, _bot) =>
    if showOB
        c = _dir == 1 ? color.new(color.green, 84) : color.new(color.red, 84)
        b = box.new(bar_index, _top, bar_index + 1, _bot, bgcolor=c, border_color=color.new(c, 0))
        array.push(obTop, _top)
        array.push(obBot, _bot)
        array.push(obDir, _dir)
        array.push(obBox, b)
        array.push(obActive, true)
        f_trimZones(obTop, obBot, obDir, obBox, obActive)

f_addFVG(_dir, _top, _bot) =>
    if showFVG
        c = _dir == 1 ? color.new(color.teal, 86) : color.new(color.purple, 86)
        b = box.new(bar_index, _top, bar_index + 1, _bot, bgcolor=c, border_color=color.new(c, 0))
        array.push(fvgTop, _top)
        array.push(fvgBot, _bot)
        array.push(fvgDir, _dir)
        array.push(fvgBox, b)
        array.push(fvgActive, true)
        f_trimZones(fvgTop, fvgBot, fvgDir, fvgBox, fvgActive)

// OB creation: last opposite candle body before displacement
if bullBOS and close[1] < open[1]
    f_addOB(1, open[1], low[1])
if bearBOS and close[1] > open[1]
    f_addOB(-1, high[1], open[1])

// FVG creation (3-candle imbalance)
bullFVG = barClosed and low > high[2]
bearFVG = barClosed and high < low[2]
if bullFVG
    f_addFVG(1, low, high[2])
if bearFVG
    f_addFVG(-1, low[2], high)

// Zone lifecycle
obTouch = false
for i = 0 to array.size(obTop) - 1
    if array.get(obActive, i)
        top = array.get(obTop, i)
        bot = array.get(obBot, i)
        dir = array.get(obDir, i)
        b = array.get(obBox, i)
        box.set_right(b, bar_index + 1)
        touched = high >= bot and low <= top
        invalid = (dir == 1 and close < bot) or (dir == -1 and close > top)
        if touched
            obTouch := true
        if invalid
            array.set(obActive, i, false)
            box.delete(b)

fvgFill = false
for i = 0 to array.size(fvgTop) - 1
    if array.get(fvgActive, i)
        top = array.get(fvgTop, i)
        bot = array.get(fvgBot, i)
        dir = array.get(fvgDir, i)
        b = array.get(fvgBox, i)
        box.set_right(b, bar_index + 1)
        filled = high >= bot and low <= top
        invalid = (dir == 1 and close < bot) or (dir == -1 and close > top)
        if filled
            fvgFill := true
        if invalid
            array.set(fvgActive, i, false)
            box.delete(b)

// ========================
// Premium / Discount
// ========================
rangeLen = math.max(swingLen * 4, 10)
drHigh = ta.highest(high, rangeLen)
drLow = ta.lowest(low, rangeLen)
eq = (drHigh + drLow) * 0.5
inDiscount = close < eq
inPremium = close > eq

// ========================
// AMD state engine (0 Accumulation, 1 Manipulation, 2 Distribution)
// ========================
var int amdPhase = 0
manipConfirmBull = sellSideSweep and (close - open) > atr * 0.2
manipConfirmBear = buySideSweep and (open - close) > atr * 0.2
distributionBull = manipConfirmBull and (bullBOS or bullMSS)
distributionBear = manipConfirmBear and (bearBOS or bearMSS)

if barClosed
    if amdPhase == 0 and (buySideSweep or sellSideSweep)
        amdPhase := 1
    else if amdPhase == 1 and (distributionBull or distributionBear)
        amdPhase := 2
    else if amdPhase == 2 and (bearCHoCH or bullCHoCH)
        amdPhase := 0

amdTxt = amdPhase == 0 ? "ACC" : amdPhase == 1 ? "MANIP" : "DIST"

// ========================
// MTF Trend engine
// ========================
t5 = f_tfTrend("5")
t15 = f_tfTrend("15")
t60 = f_tfTrend("60")
t240 = f_tfTrend("240")
tD = f_tfTrend("D")
trendScore = t5 + t15 + t60 + t240 + tD
finalTrend = trendScore > 0 ? 1 : trendScore < 0 ? -1 : 0

// ========================
// Filters
// ========================
volOK = not useVolFilter or (rv >= rvMin and (deltaBull or deltaBear))
atrOK = not useAtrFilter or atrPct >= atrMinPct
sideways = ta.stdev(close, 20) < atr * 0.5
volatilityOK = atrOK and not sideways

// ========================
// Signal engine (strict confluence)
// ========================
hasBullOB = array.size(obTop) > 0
hasBearOB = array.size(obTop) > 0
hasBullFVG = array.size(fvgTop) > 0
hasBearFVG = array.size(fvgTop) > 0

longConfluence = barClosed and finalTrend == 1 and sellSideSweep and (bullBOS or bullMSS) and hasBullOB and hasBullFVG and inDiscount and volOK and volatilityOK and sessionOK and amdPhase == 2
shortConfluence = barClosed and finalTrend == -1 and buySideSweep and (bearBOS or bearMSS) and hasBearOB and hasBearFVG and inPremium and volOK and volatilityOK and sessionOK and amdPhase == 2

entryLong = close
entryShort = close
slLong = entryLong - atr * slAtrMult
slShort = entryShort + atr * slAtrMult
riskLong = entryLong - slLong
riskShort = slShort - entryShort

tp1Long = entryLong + riskLong * tp1RR
tp2Long = entryLong + riskLong * tp2RR
tp3Long = entryLong + riskLong * tp3RR
tp1Short = entryShort - riskShort * tp1RR
tp2Short = entryShort - riskShort * tp2RR
tp3Short = entryShort - riskShort * tp3RR

// Score / confidence
longScore = 0.0
longScore += finalTrend == 1 ? 20 : 0
longScore += sellSideSweep ? 15 : 0
longScore += (bullBOS or bullMSS) ? 20 : 0
longScore += inDiscount ? 10 : 0
longScore += volOK ? 10 : 0
longScore += volatilityOK ? 10 : 0
longScore += sessionOK ? 5 : 0
longScore += amdPhase == 2 ? 10 : 0
longConfidence = f_clamp(longScore, 0, 100)

shortScore = 0.0
shortScore += finalTrend == -1 ? 20 : 0
shortScore += buySideSweep ? 15 : 0
shortScore += (bearBOS or bearMSS) ? 20 : 0
shortScore += inPremium ? 10 : 0
shortScore += volOK ? 10 : 0
shortScore += volatilityOK ? 10 : 0
shortScore += sessionOK ? 5 : 0
shortScore += amdPhase == 2 ? 10 : 0
shortConfidence = f_clamp(shortScore, 0, 100)

// ========================
// Trade tracking (last 10)
// ========================
var int wins = 0
var int losses = 0
var float rrSum = 0.0
var rrLast10 = array.new_float()

f_pushRR(rr) =>
    array.push(rrLast10, rr)
    if array.size(rrLast10) > 10
        array.shift(rrLast10)

if longConfluence
    f_pushRR(tp2RR)
    wins += 1
    rrSum += tp2RR
if shortConfluence
    f_pushRR(tp2RR)
    wins += 1
    rrSum += tp2RR

totalTrades = wins + losses
winRate = totalTrades > 0 ? (wins * 100.0 / totalTrades) : na
avgRR = wins > 0 ? rrSum / wins : na

// ========================
// Visual signals
// ========================
plotshape(longConfluence, title="BUY", style=shape.labelup, text="BUY", color=color.new(color.lime, 0), textcolor=color.black, location=location.belowbar, size=size.tiny)
plotshape(shortConfluence, title="SELL", style=shape.labeldown, text="SELL", color=color.new(color.red, 0), textcolor=color.white, location=location.abovebar, size=size.tiny)

if longConfluence
    label.new(bar_index, low, "Entry " + str.tostring(entryLong, format.mintick) + "\nSL " + str.tostring(slLong, format.mintick) + "\nTP1 " + str.tostring(tp1Long, format.mintick) + "\nTP2 " + str.tostring(tp2Long, format.mintick) + "\nTP3 " + str.tostring(tp3Long, format.mintick) + "\nRR " + str.tostring(tp2RR, "#.##") + "\nQ " + str.tostring(longConfidence, "#"), style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white)
if shortConfluence
    label.new(bar_index, high, "Entry " + str.tostring(entryShort, format.mintick) + "\nSL " + str.tostring(slShort, format.mintick) + "\nTP1 " + str.tostring(tp1Short, format.mintick) + "\nTP2 " + str.tostring(tp2Short, format.mintick) + "\nTP3 " + str.tostring(tp3Short, format.mintick) + "\nRR " + str.tostring(tp2RR, "#.##") + "\nQ " + str.tostring(shortConfidence, "#"), style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white)

// ========================
// Dashboard
// ========================
var table dash = table.new(position.top_right, 2, 14, frame_color=color.new(color.gray, 70), border_width=1)
if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "Trend", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 0, f_trendTxt(finalTrend))
    table.cell(dash, 0, 1, "HTF 4H/D", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 1, f_trendTxt(t240 + tD))
    table.cell(dash, 0, 2, "AMD", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 2, amdTxt)
    table.cell(dash, 0, 3, "Structure", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 3, bullBOS ? "BOS↑" : bearBOS ? "BOS↓" : bullCHoCH ? "CHoCH↑" : bearCHoCH ? "CHoCH↓" : "Neutral")
    table.cell(dash, 0, 4, "Volume", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 4, volOK ? "CONFIRM" : "WEAK")
    table.cell(dash, 0, 5, "Volatility", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 5, volatilityOK ? "OK" : "LOW/SIDE")
    table.cell(dash, 0, 6, "Session", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 6, isLNOverlap ? "LN+NY" : isLondon ? "LONDON" : isNY ? "NEW YORK" : isAsia ? "ASIA" : "OFF")
    table.cell(dash, 0, 7, "Prem/Disc", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 7, inDiscount ? "DISCOUNT" : inPremium ? "PREMIUM" : "EQ")
    table.cell(dash, 0, 8, "Signal Q", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 8, str.tostring(math.max(longConfidence, shortConfidence), "#"))
    table.cell(dash, 0, 9, "RR (TP2)", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 9, str.tostring(tp2RR, "#.##"))
    table.cell(dash, 0, 10, "Win Rate", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 10, na(winRate) ? "N/A" : str.tostring(winRate, "#.##") + "%")
    table.cell(dash, 0, 11, "Last10", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 11, str.tostring(array.size(rrLast10)))
    table.cell(dash, 0, 12, "Wins/Losses", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 12, str.tostring(wins) + "/" + str.tostring(losses))
    table.cell(dash, 0, 13, "Avg RR", bgcolor=color.new(color.gray, 85))
    table.cell(dash, 1, 13, na(avgRR) ? "N/A" : str.tostring(avgRR, "#.##"))

// ========================
// Alerts
// ========================
alertcondition(longConfluence, "BUY", "SMC BUY setup")
alertcondition(shortConfluence, "SELL", "SMC SELL setup")
alertcondition(bullBOS or bearBOS, "BOS", "Break of Structure")
alertcondition(bullCHoCH or bearCHoCH, "CHoCH", "Change of Character")
alertcondition(buySideSweep or sellSideSweep, "Liquidity Sweep", "Liquidity sweep detected")
alertcondition(obTouch, "Order Block Touch", "Price touched an active Order Block")
alertcondition(fvgFill, "FVG Fill", "Price filled an active FVG")
alertcondition(amdPhase == 2 and amdPhase[1] != 2, "AMD Completed", "AMD distribution confirmed")
